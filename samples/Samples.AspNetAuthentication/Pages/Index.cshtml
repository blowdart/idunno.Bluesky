@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@if (User is null || User.Identity is null || !User.Identity.IsAuthenticated)
{
<div class="text-center">
  <h1 class="display-4">
    Welcome
  </h1>
</div>
}
@if (Model.Timeline is not null && Model.Timeline.Count > 0)
{
    <table>
        <tbody>
            @foreach (var entry in Model.Timeline)
            {
                <tr>
                    <td class="align-top"><img class="rounded-circle" loading="lazy" fetchpriority="auto" height="42" width="42" src="@entry.Post.Author.Avatar" alt="@entry.Post.Author.DisplayName" /></td>
                    <td>
                        @if (!string.IsNullOrEmpty(entry.Post.Author.DisplayName))
                        {
                            <b>@entry.Post.Author.DisplayName</b> 
                        }
                        @entry.Post.Author.Handle.Value @@ @entry.Post.Record.CreatedAt.ToLocalTime().ToString("g")<br />
                        @entry.Post.Record.Text<br />
                        @if (entry.Post.Embed is idunno.Bluesky.Embed.EmbeddedImagesView images)
                        {
                            <img src="@images.Images[0].ThumbnailUri" alt="@images.Images[0].AltText" class="rounded" loading="lazy" fetchpriority="auto" /><br />
                        }
                        @if (entry.Post.LikeCount > 0) {
                            <text>@entry.Post.LikeCount like@(entry.Post.LikeCount != 1 ? "s" : "") </text>
                        }
                        @if (entry.Post.RepostCount > 0) {
                            <text>@entry.Post.RepostCount repost@(entry.Post.RepostCount != 1 ? "s" : "")</text>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
