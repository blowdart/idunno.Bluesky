@page
@{
    ViewData["Title"] = "Manage Profile";
}
@model IndexModel
@{
    <h1>Manage Profile</h1>
    <p>Login only requests read permissions. Saving requests profile create/update permissions required by the server when needed.
        Pending edits expire after ten minutes.</p>

    @if (Model.ProfileMessage is not null)
    {
        <p role="status">@Model.ProfileMessage</p>
    }
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @if (Model.CompletionId is not null)
    {
        <form method="post" asp-page-handler="Complete" id="complete-profile-save">
            <input type="hidden" name="completionId" value="@Model.CompletionId" />
            <button type="submit" class="btn btn-primary">Complete save</button>
        </form>
    }
    else
    {
        <form method="post" asp-route-cid="@Model.Cid">
            <div class="row mb-3">
                <label asp-for="DisplayName" class="col-sm-2 col-form-label">Display Name</label>
                <div class="col-sm-10">
                    <input asp-for="DisplayName" class="form-text" />
                    <div asp-validation-for="DisplayName" class="text-danger"></div>
                </div>
            </div>

            <div class="row mb-3">
                <label asp-for="Description" class="col-sm-2 col-form-label">Description</label>
                <div class="col-sm-10">
                    <input asp-for="Description" class="form-text" />
                    <div asp-validation-for="Description" class="text-danger"></div>
                </div>
            </div>

            <div class="row mb-3">
                <label asp-for="Pronouns" class="col-sm-2 col-form-label">Pronouns</label>
                <div class="col-sm-10">
                    <input asp-for="Pronouns" class="form-text" />
                    <span asp-validation-for="Pronouns" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Update</button>
        </form>
    }
    @if (Model.PendingEditId is not null)
    {
        <form method="post" asp-page-handler="Discard" class="mt-3">
            <input type="hidden" name="pendingId" value="@Model.PendingEditId" />
            <button type="submit" class="btn btn-secondary">Discard pending edits and reload profile</button>
        </form>
    }
}
