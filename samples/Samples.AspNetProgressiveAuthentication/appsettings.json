{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.AspNetCore": "Warning",
            "Samples.AspNetProgressiveAuthentication": "Warning",
            "idunno.AtProto": "Debug",
            "idunno.Bluesky": "Debug"
        }
    },

    "Console": {
        "IncludeScopes": true,
        "FormatterName": "Simple",
        "FormatterOptions": {
            "SingleLine": true,
            "IncludeScopes": true,
            "TimestampFormat": "HH:mm:ss ",
            "UseUtcTimestamp": true
        }
    },

    "BlueskyAgent": {
        "EnableBackgroundTokenRefresh": false,

        "OAuthOptions": {
            "ClientId": "https://example.idunno.blue/oauth-client-metadata.json",
            "ReturnUri": "https://example.idunno.blue/Bluesky/Callback"
        }
    },

    "AllowedHosts": "localhost;127.0.0.1"
}
