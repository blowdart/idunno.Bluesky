{
  "AllowedHosts": "dotnet.blue;localhost",
  "BlueskyAgent": {
    "OAuthOptions": {
      "ClientId": "https://dotnet.blue/oauth-client-metadata.json",
      "ClientName": "idunnoBlueskySample",
      "ClientUri": "https://dotnet.blue/",
      "PolicyUri": "https://dotnet.blue/privacy",
      "TosUri": "https://dotnet.blue/tos",
      "ReturnUri": "https://dotnet.blue/Bluesky/Callback",
      "Scopes": [ "atproto" ],
      "ClientSigningKeyPath": "~/.blueskyDotnet/client-signing-key.pem"
    }
  }
}
