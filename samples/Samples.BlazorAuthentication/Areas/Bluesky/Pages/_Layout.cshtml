@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using idunno.Bluesky.AspNet.Authentication
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Blazor Bluesky</title>
    <link rel="stylesheet" href="~/Bluesky/css/bluesky-auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav aria-label="Main navigation">
            <a href="/">Blazor Bluesky</a>
            <a href="/Privacy">Privacy</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/Claims">Claims</a>
                <details class="account-menu">
                    <summary class="signed-in-user" aria-label="Account options">
                        @if (User.GetAvatar() is Uri avatar)
                        {
                            <img src="@avatar" alt="Avatar" width="30" height="30" />
                        }
                        <span>@(User.GetHandle()?.ToString() ?? User.GetDisplayName() ?? "Account")</span>
                    </summary>
                    <div class="account-menu-options">
                        <a href="/Manage">Manage profile</a>
                        <a href="/Bluesky/Logout?returnUrl=%2F">Sign out</a>
                    </div>
                </details>
            }
            else
            {
                <a class="sign-in-link" href="/Bluesky/Login?returnUrl=%2F">Sign in</a>
            }
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
