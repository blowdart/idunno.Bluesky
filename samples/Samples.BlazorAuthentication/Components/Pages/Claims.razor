@page "/Claims"
@attribute [Authorize]
@inject CircuitBlueskyClient Client
@implements IDisposable

<PageTitle>User claims</PageTitle>
<h1>User claims</h1>
<p>Credentials and DPoP proof material are never displayed.</p>
<table>
    <thead><tr><th>Type</th><th>Value</th><th>Issuer</th></tr></thead>
    <tbody>
        @foreach (var claim in _claims)
        {
            <tr><td>@claim.Type</td><td>@claim.Value</td><td>@claim.Issuer</td></tr>
        }
    </tbody>
</table>
@if (_error is not null)
{
    <p role="alert" class="error">@_error</p>
}
@if (_expiresOn is not null)
{
    <p>Access token expires on @_expiresOn.Value.ToLocalTime().ToString("G").</p>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private IEnumerable<Claim> _claims = [];
    private DateTimeOffset? _expiresOn;
    private string? _error;
    private readonly CancellationTokenSource _cancellation = new();

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState).User;
        _claims = user.Claims.Where(claim => claim.Type is not
            (AtProtoClaims.AccessToken or AtProtoClaims.RefreshToken or AtProtoClaims.DPoPProof or AtProtoClaims.DPoPNonce));
        try
        {
            _expiresOn = await Client.ExecuteAsync((agent, _) => Task.FromResult(agent.Credentials!.ExpiresOn), _cancellation.Token);
        }
        catch (AuthenticationException ex)
        {
            _error = ex.Message;
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested)
        {
        }
    }

    public void Dispose()
    {
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}
