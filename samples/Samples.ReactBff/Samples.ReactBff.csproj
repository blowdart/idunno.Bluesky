<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <UserSecretsId>idunno-Bluesky-ReactBff-Sample</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\idunno.Bluesky.AspNet.Authentication\idunno.Bluesky.AspNet.Authentication.csproj" />
    <InternalsVisibleTo Include="Samples.ReactBff.Test" Key="" />
  </ItemGroup>
  <Target Name="NpmInstall" Inputs="ClientApp\package.json;ClientApp\package-lock.json" Outputs="ClientApp\node_modules\.package-lock.json">
    <Exec Command="npm ci --no-audit --no-fund --ignore-scripts" WorkingDirectory="$(MSBuildProjectDirectory)\ClientApp" />
  </Target>
  <Target Name="NpmBuild" DependsOnTargets="NpmInstall" BeforeTargets="BeforeBuild">
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\ClientApp" />
  </Target>
  <Target Name="NpmTest" DependsOnTargets="NpmBuild" BeforeTargets="Build">
    <Exec Command="npm test" WorkingDirectory="$(MSBuildProjectDirectory)\ClientApp" />
  </Target>
</Project>
