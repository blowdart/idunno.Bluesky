@page
@model idunno.Bluesky.AspNet.Labeler.UI.Areas.Xenon.Pages.Labels.IndexModel
@{
    ViewData["Title"] = "Manual labels";
}
<h1>Manual labels</h1>
<p>Apply or withdraw labels without opening a report or case. An account label applies to the account; a content label applies to an item such as a post or list. Labeling the profile record labels that profile content, not the whole account.</p>
<section class="panel">
    <form method="post" data-manual-labels>
        <label class="field">Account handle or ID (DID), content address (AT URI), or Bluesky URL
            <input name="target" value="@Model.Target" required maxlength="2048" autocomplete="off" />
        </label>
        <label class="field" data-record-cid>Specific content version (CID, optional)
            <input name="cid" value="@Model.Cid" maxlength="128" autocomplete="off" />
        </label>
        <p>For content, enter a CID to label only that version. Leave it blank to apply the label across all versions, including future edits. This field does not apply to account labels.</p>
        <p><button type="submit" asp-page-handler="Lookup" data-load-labels formnovalidate>Load labels</button></p>
        <div data-manual-label-controls aria-live="polite" aria-busy="false">
            @await Html.PartialAsync("_ManualLabelChoices", Model.Labels)
        </div>
        <label class="field">Reason for labelling
            <textarea name="reason" required maxlength="4096" readonly="@Model.Labels.Retrying">@Model.Reason</textarea>
        </label>
        <p class="form-actions"><button type="submit" data-submit-labels disabled="@(Model.Labels.State is null)">@(Model.Labels.Retrying ? "Retry unchanged changes" : "Submit label changes")</button></p>
    </form>
</section>
