@page
@model idunno.Bluesky.AspNet.Labeler.UI.Areas.Xenon.Pages.Lifecycle.IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = "Lifecycle";
    JsonElement? maintenance = Model.Maintenance.ValueKind == JsonValueKind.Object &&
        Model.Maintenance.TryGetProperty("maintenance", out JsonElement maintenanceValue) ? maintenanceValue : null;
    JsonElement? retirement = Model.Retirement.ValueKind == JsonValueKind.Object &&
        Model.Retirement.TryGetProperty("retirement", out JsonElement retirementValue) ? retirementValue : null;
}
<h1>Labeler lifecycle</h1>
@if (Model.LifecycleError is string lifecycleError)
{
    <p role="alert">@lifecycleError</p>
}
<p><strong>Retiring this labeler is permanent.</strong> It stops applying new labels and accepting new reports and appeals. Existing labels are withdrawn, and those withdrawals remain available for other apps to collect.</p>
<p>Retirement continues if you close this page or restart the service. You can pause the work, but pausing does not reopen the labeler. Refresh this page to see progress.</p>
<p>Before finishing, allow time for other apps to collect the withdrawals. Xenon cannot confirm that every app has received them. Withdrawals remain available after retirement unless you delete the retained label history.</p>
<p>If you permanently shut down the public label service, remove its labeler service address from the account's DID document (its public identity information). Do this only after the waiting period has ended, you have reviewed availability and completed retirement, and you have decided to stop distributing withdrawals. Keep the public verification keys so historical label signatures can still be checked. Xenon does not update the DID document for you; arrange this separately through your account provider or identity-management tools. You do not need to delete the account, and deleting it is not a substitute for checking that the endpoint reference has been removed.</p>
<p>If a signing key needs replacing, use the administration CLI to coordinate the change across your servers. Review any service outages and extend the waiting period if needed.</p>
@if (maintenance is { ValueKind: JsonValueKind.Object } maintenanceState)
{
    <section class="panel">
        <h2>Service maintenance</h2>
        @if (maintenanceState.GetProperty("phase").GetString() == "None")
        {
            <p>No maintenance in progress.</p>
        }
        else
        {
            <p>Key replacement and server shutdown status: <strong>@UiPageHelpers.FormatEnumLabel(maintenanceState.GetProperty("phase").GetString())</strong></p>
            <details><summary>Technical details</summary><pre>@maintenanceState.ToString()</pre></details>
            <p>An unreachable server is not proof that its signing process has stopped. Resolve the maintenance problems before retrying.</p>
        }
    </section>
}
@if (retirement is { ValueKind: JsonValueKind.Object } state)
{
    string phase = state.GetProperty("phase").GetString() ?? "";
    string keyRemoval = state.GetProperty("keyRemoval").GetString() ?? "";
    string stage = state.GetProperty("stage").GetString() ?? "";
    bool running = state.GetProperty("running").GetBoolean();
    bool hasSavedWorkflow = state.TryGetProperty("operationId", out JsonElement workflow) &&
        workflow.ValueKind == JsonValueKind.String &&
        !string.IsNullOrWhiteSpace(workflow.GetString());
    if (hasSavedWorkflow)
    {
        <section class="panel">
            <h2>Retirement progress</h2>
            <p>Status: <strong>@UiPageHelpers.FormatEnumLabel(phase)</strong>. Current step: @UiPageHelpers.FormatEnumLabel(stage).</p>
            <p>@(running ? "Retirement is allowed to continue." : "Retirement is not currently allowed to continue.") This is not proof that a server process is running.</p>
            <details><summary>Technical details</summary>
            <dl>
                @if (state.TryGetProperty("issuer", out JsonElement issuer))
                {
                    <dt>Labeler account</dt><dd><code>@issuer.GetString()</code></dd>
                }
                <dt>Status / current step</dt><dd>@UiPageHelpers.FormatEnumLabel(phase) / @UiPageHelpers.FormatEnumLabel(stage)</dd>
                <dt>Allowed to continue</dt><dd>@(running ? "Yes" : "No")</dd>
                <dt>Tracking ID / change number</dt><dd>@workflow.GetString() / @state.GetProperty("generation")</dd>
                <dt>Label history included through entry</dt><dd>@state.GetProperty("upperBound")</dd>
                <dt>History checked through entry</dt><dd>@state.GetProperty("scannedThrough")</dd>
                <dt>Withdrawals processed through entry</dt><dd>@state.GetProperty("negatedThrough")</dd>
                <dt>Created / ready for distribution through entry</dt><dd>@state.GetProperty("issuedThrough") / @state.GetProperty("publishedThrough")</dd>
                <dt>History entries awaiting distribution</dt><dd>@(state.GetProperty("issuedThrough").GetInt64() - state.GetProperty("publishedThrough").GetInt64())</dd>
                <dt>Waiting period ends (service time)</dt><dd>@(state.TryGetProperty("graceDeadline", out JsonElement deadline) ? deadline.ToString() : "Not started")</dd>
                <dt>Last attempt (not proof work is still running)</dt><dd>@(state.TryGetProperty("lastActivityAt", out JsonElement activity) ? activity.ToString() : "Not recorded")</dd>
                <dt>Last progress</dt><dd>@(state.TryGetProperty("lastProgressAt", out JsonElement progress) ? progress.ToString() : "Not recorded")</dd>
                <dt>Reported key removal (not independently verified)</dt><dd>@UiPageHelpers.FormatEnumLabel(keyRemoval)</dd>
                <dt>Selected signing key ID</dt><dd>@(state.TryGetProperty("signingKeyId", out JsonElement keyId) ? keyId.GetString() : "Not reported")</dd>
                <dt>Public signing fingerprint</dt><dd><code>@(state.TryGetProperty("signingPublicKey", out JsonElement publicKey) ? publicKey.GetString() : "Not reported")</code></dd>
            </dl>
            </details>
            @if (state.TryGetProperty("hosts", out JsonElement hosts))
            {
                <details><summary>Registered servers (last contact does not prove a process has stopped)</summary><pre>@hosts.ToString()</pre></details>
            }
            @if (state.TryGetProperty("pauseReason", out JsonElement pause) && pause.ValueKind == JsonValueKind.String)
            {
                <p role="alert">Paused: @pause.GetString(). Fix the problem or restore the required permissions, then choose Resume retirement with a new tracking ID. Saved progress is kept.</p>
            }
            @if (state.TryGetProperty("blocker", out JsonElement blocker) && blocker.ValueKind == JsonValueKind.String)
            {
                <p role="alert">Retirement cannot continue: @blocker.GetString()</p>
            }
            @if (state.TryGetProperty("inventory", out JsonElement inventory))
            {
                <h3>Recorded signing keys and copies</h3><pre>@inventory.GetString()</pre>
            }
            @if (state.TryGetProperty("availabilityAttestation", out JsonElement availability))
            {
                <h3>Service availability checks you recorded</h3><pre>@availability.GetString()</pre>
            }
        </section>
    }
    else
    {
        <p>Retirement not started.</p>
    }
    @if (Model.Intent is { } intent)
    {
        <section class="panel">
            <h2>Review and confirm @UiPageHelpers.FormatRetirementAction(intent.Method)</h2>
            <p>Nothing has changed yet. Review the action and details below, then confirm. If the labeler's state changes or this confirmation expires, you will need to review it again.</p>
            <dl>
                <dt>Action</dt><dd><code>@intent.Method</code></dd>
                <dt>Tracking ID</dt><dd><code>@intent.OperationId</code></dd>
                <dt>Reason</dt><dd>@intent.Reason</dd>
                <dt>Waiting period (days)</dt><dd>@intent.GracePeriodDays</dd>
                <dt>Where signing keys and copies are stored</dt><dd>@intent.Inventory</dd>
                <dt>Checks you performed</dt><dd>@intent.Attestation</dd>
                <dt>Server registration ID</dt><dd><code>@intent.HostInstanceId</code></dd>
                <dt>Selected signing key ID</dt><dd>@(state.TryGetProperty("signingKeyId", out JsonElement previewKeyId) ? previewKeyId.GetString() : "Not reported")</dd>
                <dt>Public signing fingerprint</dt><dd><code>@(state.TryGetProperty("signingPublicKey", out JsonElement previewPublicKey) ? previewPublicKey.GetString() : "Not reported")</code></dd>
                <dt>Confirmation code</dt><dd><code>@(state.TryGetProperty("confirmation", out JsonElement proof) ? proof.GetString() : "Not required for this action")</code></dd>
                <dt>Confirmation expires</dt><dd>@(state.TryGetProperty("confirmationExpiresAt", out JsonElement expires) ? expires.ToString() : "Not applicable")</dd>
            </dl>
            @if (state.TryGetProperty("hosts", out JsonElement previewHosts))
            {
                <details><summary>Registered servers (last contact does not prove a process has stopped)</summary><pre>@previewHosts.ToString()</pre></details>
            }
            @if (intent.Method == "purgeRetiredData")
            {
                <p><strong>This permanently deletes retained label history and the records used to recognize repeated label requests.</strong> Reports, cases, appeals, policies, team details and activity history are kept. Backups and copies held by other apps are not deleted. Deleted labels will no longer be available from this service.</p>
            }
            @if (intent.Method is "requestKeyRemoval" or "attestKeyRemoval")
            {
                <p>This step prevents further signing, but does not delete key files or stop server processes for you. Stop every process that could still use the private signing key and remove its copies yourself. Record what you checked, what you removed, and anything still outstanding. Never paste a private key here.</p>
                <p><strong>Keep public verification keys, account/repository keys and sign-in keys.</strong> Recording removal does not prove that every copy has been deleted. Deleting label history is a separate action.</p>
            }
            @if (intent.Method == "confirmRetirementHostStopped")
            {
                <p><strong>Confirm that you checked this specific server process and it has stopped.</strong> Being unreachable or not contacting the service recently is not proof. This records your check; it does not stop the process or remove keys from memory. You must review signing-key removal again afterwards.</p>
            }
            <form method="post">
                <input type="hidden" name="stage" value="execute" />
                <input type="hidden" name="method" value="@intent.Method" />
                <input type="hidden" name="operationId" value="@intent.OperationId" />
                <input type="hidden" name="reason" value="@intent.Reason" />
                <input type="hidden" name="graceDays" value="@intent.GracePeriodDays" />
                <input type="hidden" name="inventory" value="@intent.Inventory" />
                <input type="hidden" name="attestation" value="@intent.Attestation" />
                <input type="hidden" name="hostInstanceId" value="@intent.HostInstanceId" />
                <input type="hidden" name="confirmation" value="@(state.TryGetProperty("confirmation", out JsonElement challenge) ? challenge.GetString() : "")" />
                <label class="field">To confirm, type <code>@intent.Method</code> exactly as shown
                    <input name="confirmationText" required maxlength="32" autocomplete="off" />
                </label>
                <button type="submit">Confirm @UiPageHelpers.FormatRetirementAction(intent.Method)</button>
                <a asp-page="./Index">Cancel and refresh</a>
            </form>
        </section>
    }
    else
    {
        List<(string Method, string Title)> actions = [];
        bool signing = phase is "Retiring" or "Distributing";
        bool cleanup = phase is "Retired" or "Purged";
        bool removalStarted = keyRemoval is not ("" or "None");
        if (phase == "Active")
        {
            actions.Add(("beginRetirement", "Start permanent retirement"));
        }
        if (signing || phase == "Purging")
        {
            actions.Add(running ? ("pauseRetirement", "Pause retirement") : ("resumeRetirement", "Resume retirement"));
        }
        if (phase == "Distributing" && state.GetProperty("issuedThrough").GetInt64() == state.GetProperty("publishedThrough").GetInt64())
        {
            actions.Add(("beginGracePeriod", "Start the waiting period"));
        }
        if (phase == "Grace")
        {
            actions.Add(("extendGracePeriod", "Extend the waiting period"));
            actions.Add(("completeRetirement", "Record your checks and finish retirement"));
        }
        if (phase == "Retired" && keyRemoval != "Requested")
        {
            actions.Add(("purgeRetiredData", "Delete retained label history"));
        }
        if (cleanup && !removalStarted && state.GetProperty("issuedThrough").GetInt64() == state.GetProperty("publishedThrough").GetInt64())
        {
            actions.Add(("requestKeyRemoval", "Start signing-key removal"));
        }
        if (cleanup && removalStarted && keyRemoval != "Attested")
        {
            actions.Add(("attestKeyRemoval", "Record signing-key removal"));
        }
        @if (cleanup && state.TryGetProperty("hosts", out JsonElement retirementHosts) && retirementHosts.ValueKind == JsonValueKind.Array)
        {
            @foreach (JsonElement host in retirementHosts.EnumerateArray())
            {
                <section class="panel">
                    <h2>Confirm this server process has stopped <code>@host.GetProperty("instanceId").GetString()</code></h2>
                    <p>Check that this exact process has stopped before submitting. An unreachable server or its last contact time (@host.GetProperty("lastSeen")) is not enough. This records your check; it does not stop the process or verify key deletion.</p>
                    <form method="post">
                        <input type="hidden" name="stage" value="preview" />
                        <input type="hidden" name="method" value="confirmRetirementHostStopped" />
                        <input type="hidden" name="hostInstanceId" value="@host.GetProperty("instanceId").GetString()" />
                        <label class="field">Tracking ID<input name="operationId" value="@Guid.NewGuid().ToString("N")" required maxlength="256" /></label>
                        <label class="field">Reason<input name="reason" required maxlength="4096" /></label>
                        <label class="field">How you checked that the process has stopped<textarea name="attestation" required maxlength="4096"></textarea></label>
                        <button type="submit">Review your stopped-process check</button>
                    </form>
                </section>
            }
        }
        @foreach ((string method, string title) in actions)
        {
            <section class="panel">
                <h2>@title</h2>
                @if (method is "requestKeyRemoval" or "attestKeyRemoval")
                {
                    <p>List every signing server, key fingerprint, external copy, secret-manager version and backup category. Record what you checked, removed, and still need to remove. This is your record, not independent proof of deletion. Never include private keys or other secrets.</p>
                }
                @if (method == "purgeRetiredData")
                {
                    <p>This permanently deletes retained label history and the records used to recognize repeated label requests. Reports, cases, appeals, policies, team details and activity history are kept. Backups and copies held by other apps are not deleted. Deleted labels will no longer be available from this service.</p>
                }
                @if (method is "beginGracePeriod" or "extendGracePeriod")
                {
                    <p>Choose how many days to keep the withdrawals available before finishing retirement. Check that the public label service remains reachable during this period. Extend the period if an outage may have prevented other apps from collecting them.</p>
                }
                @if (method == "completeRetirement")
                {
                    <p>After the waiting period ends, record how you checked that withdrawals remained available, including any outages. This does not confirm that every app received them.</p>
                }
                <form method="post">
                    <input type="hidden" name="stage" value="preview" />
                    <input type="hidden" name="method" value="@method" />
                    <label class="field">Tracking ID<input name="operationId" value="@(ViewData["OperationId"] ?? Guid.NewGuid().ToString("N"))" required maxlength="256" /></label>
                    <label class="field">Reason<input name="reason" required maxlength="4096" /></label>
                    @if (method is "beginGracePeriod" or "extendGracePeriod")
                    {
                        <label class="field">Waiting period (days, 1-365)<input type="number" name="graceDays" min="1" max="365" required /></label>
                    }
                    @if (method is "requestKeyRemoval" or "attestKeyRemoval")
                    {
                        <label class="field">Where signing keys and copies are stored<textarea name="inventory" required maxlength="16384">@((state.TryGetProperty("inventory", out JsonElement savedInventory)) ? savedInventory.GetString() : "")</textarea></label>
                    }
                    @if (method is "completeRetirement" or "attestKeyRemoval")
                    {
                        <label class="field">@(method == "completeRetirement" ? "Service availability checks and outages during the waiting period" : "Checks you performed: stopped processes, removed copies and anything outstanding")<textarea name="attestation" required maxlength="4096"></textarea></label>
                    }
                    <button type="submit">Review: @title</button>
                </form>
            </section>
        }
    }
}
else
{
    <p role="alert">Retirement status could not be loaded. Refresh to try again. Actions are unavailable until the current status can be checked.</p>
}
