@page
@model idunno.Bluesky.AspNet.Labeler.UI.Areas.Xenon.Pages.Policy.IndexModel
@using System.Text.Json
@using idunno.Bluesky.AspNet.Labeler.UI.Areas.Xenon.Pages.Policy
@{
    ViewData["Title"] = "Policy";
    JsonElement? policy = Model.Data.ValueKind == JsonValueKind.Object &&
        Model.Data.TryGetProperty("moderation", out JsonElement moderation) &&
        moderation.TryGetProperty("policy", out JsonElement state) ? state : null;
    JsonElement editor = Model.Editor;
    bool hasEditor = editor.ValueKind == JsonValueKind.Object;
    JsonElement declaration = hasEditor ? editor.GetProperty("declaration") : default;
    string[] subjects = declaration.ValueKind == JsonValueKind.Object && declaration.TryGetProperty("subjectTypes", out JsonElement subjectTypes)
        ? subjectTypes.EnumerateArray().Select(value => value.GetString()!).ToArray() : [];
    string reportCollections = declaration.ValueKind == JsonValueKind.Object && declaration.TryGetProperty("subjectCollections", out JsonElement accepted)
        ? string.Join(", ", accepted.EnumerateArray().Select(value => value.GetString())) : string.Empty;
    if (Model.HasSubmittedDraft)
    {
        subjects = Request.Form["reportSubjects"].Select(value => value!).ToArray();
        reportCollections = Request.Form["reportCollections"].ToString();
    }
    bool reportAllCollections = Model.HasSubmittedDraft ? Request.Form["reportAllCollections"] == "true" :
        declaration.ValueKind != JsonValueKind.Object || !declaration.TryGetProperty("subjectCollections", out _);
    bool issueAllCollections = Model.HasSubmittedDraft ? Request.Form["issueAllCollections"] == "true" :
        !hasEditor || !editor.TryGetProperty("allowedRecordCollections", out JsonElement issueCollections) || issueCollections.ValueKind == JsonValueKind.Null;
}
<h1>Moderation policy</h1>
<p>Policy drafts and publication history are durable shared state. Saving a draft does not publish it. The declaration's remote verification gate remains authoritative for new reports and issuance.</p>
<div class="policy-tabs" data-policy-tabs data-policy-publication-submitted="@((Request.Method == "POST" && (Request.Query["handler"] == "Publish" || Request.Query["handler"] == "SignInAndPublish")).ToString().ToLowerInvariant())" data-policy-verification-submitted="@((Request.Method == "POST" && Request.Query["handler"] == "Verify").ToString().ToLowerInvariant())">
    <nav aria-label="Policy sections">
        <a href="#policy-current" data-policy-tab>Current State</a>
        <a href="#policy-labels" data-policy-tab>Labels</a>
        <a href="#policy-moderation" data-policy-tab>Moderation Policy</a>
        <a href="#policy-advanced" data-policy-tab>Advanced</a>
        <a href="#policy-publication" data-policy-tab>Publication</a>
        <a href="#policy-verification" data-policy-tab>Verification</a>
    </nav>
<div id="policy-current" data-policy-panel>
@if (policy is { ValueKind: JsonValueKind.Object } current)
{
    string phase = current.GetProperty("phase").GetString()!;
    (string phaseIcon, string phaseExplanation) = phase switch
    {
        "Unverified" => ("fa-circle-exclamation", "No policy has been verified and activated yet."),
        "Withdrawing" => ("fa-circle-pause", "Xenon is removing existing applications of labels omitted from the new policy. Worker activity and progress are shown below."),
        "Publishing" => ("fa-globe", "Cleanup is complete, but publication and successful verification are still pending. This includes waiting for labeler sign-in or retrying failed verification."),
        "VerifiedActive" => ("fa-circle-check", "The public policy matched the selected policy when last checked. Reports and issuance also require that check to remain fresh."),
        "Conflict" => ("fa-triangle-exclamation", "A conflict requires explicit administrator recovery. This can follow a detected mismatch or an abandoned publication."),
        _ => ("fa-circle-exclamation", "The policy state is not recognized. Do not assume the policy is active.")
    };
    DateTimeOffset? verifiedUntil = current.TryGetProperty("verifiedUntil", out JsonElement verificationDeadline) &&
        verificationDeadline.ValueKind == JsonValueKind.String ? verificationDeadline.GetDateTimeOffset() : null;
    DateTimeOffset databaseTime = current.GetProperty("databaseTime").GetDateTimeOffset();
    bool fresh = phase == "VerifiedActive" && verifiedUntil is { } validUntil &&
        databaseTime < validUntil &&
        databaseTime >= validUntil.AddMilliseconds(-current.GetProperty("verificationFreshnessMilliseconds").GetInt64());
    string freshnessStatus = (fresh, verifiedUntil) switch
    {
        (true, _) => "Fresh",
        (false, null) => "Not verified",
        _ when verifiedUntil <= databaseTime => "Expired",
        _ => "Not fresh"
    };
    <section class="panel">
        <h2>Current state</h2>
        <table class="policy-state" aria-label="Current policy state">
            <tbody>
            <tr><th scope="row">Phase</th><td><span class="fa-icon @phaseIcon" aria-hidden="true"></span> <strong>@IndexModel.FormatPhase(phase)</strong><br /><span class="muted">@phaseExplanation</span></td></tr>
            @if (phase == "Withdrawing" && current.TryGetProperty("withdrawal", out JsonElement currentWithdrawal) &&
                currentWithdrawal.ValueKind == JsonValueKind.Object)
            {
                <tr><th scope="row">Label withdrawal</th><td>@await Html.PartialAsync("_PolicyWithdrawalStatus", currentWithdrawal)</td></tr>
            }
            <tr><th scope="row">Revision</th><td>@current.GetProperty("revision").GetInt64()</td></tr>
            <tr><th scope="row">Issuer</th><td>@await Html.PartialAsync("_Identity", new IdentityDisplayModel(current.GetProperty("issuer").GetString(), Detailed: true))</td></tr>
            <tr><th scope="row">Verified declaration CID</th><td>@(current.TryGetProperty("verifiedCid", out JsonElement cid) ? cid.GetString() : "Not verified")</td></tr>
            <tr><th scope="row">Verification freshness</th>
            <td><span class="fa-icon @(fresh ? "fa-circle-check" : "fa-circle-exclamation")" aria-hidden="true"></span>
                <strong>@freshnessStatus</strong>
                <br /><span class="muted">@if (fresh)
                    {
                        <text>Verification is currently fresh. Other authorization and service checks still apply.</text>
                    }
                    else if (phase == "Withdrawing")
                    {
                        <text>Verification is blocked until label withdrawal completes.</text>
                    }
                    else if (verifiedUntil is { } expiredDeadline && databaseTime >= expiredDeadline)
                    {
                        <text>New reports and label issuance are blocked until <a href="#policy-verification">successful verification</a>.</text>
                    }
                    else
                    {
                        <text>New reports and label issuance are blocked until successful verification.</text>
                    }
                    Refresh this page to see the latest status.</span>
            </td></tr>
            <tr><th scope="row">@(verifiedUntil is { } expiry && databaseTime >= expiry ? "Verification expired at" : "Verification valid until")</th>
            <td>@if (verifiedUntil is { } deadline)
                {
                    <time datetime="@deadline.ToString("O")">@deadline.ToUniversalTime().ToString("u")</time>
                }
                else
                {
                    <span>Unavailable</span>
                }</td></tr>
            <tr><th scope="row">Publication operation</th><td>@(current.TryGetProperty("publicationOperationId", out JsonElement op) ? op.GetString() : "None")<br /><span class="muted">Internal tracking ID for this publication attempt. It links cleanup, sign-in, retries and audit history to the same attempt. It is not published.</span></td></tr>
            </tbody>
        </table>
        @if (current.TryGetProperty("definition", out JsonElement definition) && definition.ValueKind == JsonValueKind.Object)
        {
            <h3>Selected immutable definition</h3>
            <p>Policy ID: <code>@definition.GetProperty("version").GetString()</code></p>
            <p class="muted">The Policy ID is internal to this app and is not published as part of the policy.</p>
            <pre>@Model.CurrentDeclaration</pre>
            <p>@definition.GetProperty("rules").GetString()</p>
        }
    </section>
}
else if (ViewData["Error"] is null)
{
    <p class="panel">The moderation policy state is unavailable. Xenon moderation may not be enabled on this host.</p>
}
@if (Model.DraftDefinitions.Count > 0)
{
    <section class="panel">
        <h2>Saved drafts</h2>
        <p>These drafts have not been selected for publication. Loading a draft starts a new policy snapshot; deleting it preserves audit history.</p>
        <table>
            <caption>@Model.DraftDefinitions.Count saved drafts</caption>
            <thead><tr><th scope="col">Policy ID</th><th scope="col">Actions</th></tr></thead>
            <tbody>
            @foreach (JsonElement draft in Model.DraftDefinitions)
            {
                string version = draft.GetProperty("version").GetString()!;
                <tr>
                    <td><code>@version</code></td>
                    <td><div class="policy-draft-actions">
                        <a asp-page="./Index" asp-route-editor="draft" asp-route-draft="@version" asp-fragment="policy-labels" data-policy-load="draft" data-policy-version="@version">Load draft</a>
                        <form method="post" asp-page-handler="DeleteRequest">
                            <input type="hidden" name="version" value="@version" />
                            <button type="submit">Delete draft</button>
                        </form>
                    </div></td>
                </tr>
            }
            </tbody>
        </table>
    </section>
}
@if (Model.PendingDeletion is { } deletion)
{
    <section class="panel" role="region" aria-labelledby="policy-delete-heading">
        <h2 id="policy-delete-heading">Are you sure?</h2>
        <p>Delete draft <strong>@deletion</strong>? It will no longer be loadable or publishable. Audit and policy history are retained. The current policy will not change.</p>
        <form method="post" asp-page-handler="Delete">
            <input type="hidden" name="version" value="@deletion" />
            <input type="hidden" name="operationId" value="@(ViewData["OperationId"] ?? Guid.NewGuid().ToString("N"))" />
            <input type="hidden" name="confirmed" value="true" />
            <label class="field">Reason<input name="reason" required maxlength="4096" /></label>
            <div class="policy-draft-actions"><button type="submit">Delete draft</button><a asp-page="./Index">Cancel</a></div>
        </form>
    </section>
}
</div>
@if (hasEditor)
{
    <div class="panel policy-editor-toolbar">
        <p data-policy-source>@Model.EditorSource</p>
        <a asp-page="./Index" asp-route-editor="current" asp-fragment="policy-labels" data-policy-load="current">Load current policy</a>
        @if (Model.DraftDefinition.ValueKind == JsonValueKind.Object)
        {
            <span>@(Model.DraftDefinitions.Count == 1 ? "A saved draft is available in Current State." : $"{Model.DraftDefinitions.Count} saved drafts are available in Current State.")</span>
        }
        <a asp-page="./Index" asp-route-editor="clear" asp-fragment="policy-labels" data-policy-clear>Clear all</a>
        <p class="muted">Loading or clearing replaces only the unsaved editor. Saved policies and the current policy are unchanged. Enter a new Policy ID when saving changes.</p>
    </div>
    <textarea hidden data-policy-current>@(Model.CurrentDefinition.ValueKind == JsonValueKind.Object ? Model.CurrentDefinition.GetRawText() : "")</textarea>
    <textarea hidden data-policy-drafts>@("[" + string.Join(",", Model.DraftDefinitions.Select(draft => draft.GetRawText())) + "]")</textarea>
    <form method="post" asp-page-handler="Save" data-policy-editor data-policy-submitted="@Model.HasSubmittedDraft.ToString().ToLowerInvariant()">
        <input type="hidden" name="operationId" value="@(ViewData["OperationId"] ?? Guid.NewGuid().ToString("N"))" />
        <section class="panel" id="policy-labels" data-policy-panel>
            <h2>Declared labels</h2>
            <p>Declare label values and optionally define their client presentation, default behaviour and translated text. Removing a value does not revoke labels already issued.</p>
            <div data-policy-labels></div>
            <button type="button" data-policy-add-label hidden>Add label</button>
            <noscript><p>Use the Advanced declaration JSON to edit label values and definitions without JavaScript.</p></noscript>
        </section>
        <section class="panel" id="policy-moderation" data-policy-panel>
        <h2>Moderation policy</h2>
        <fieldset data-policy-declaration-controls>
            <legend>Accepted report subjects</legend>
            <input type="hidden" name="structuredScope" value="true" />
            <label class="field-check"><input type="checkbox" name="reportSubjects" value="account" checked="@subjects.Contains("account")" /> Accounts</label>
            <label class="field-check"><input type="checkbox" name="reportSubjects" value="record" checked="@subjects.Contains("record")" /> Records</label>
            <label class="field-check"><input type="checkbox" name="reportAllCollections" value="true" checked="@reportAllCollections" /> Accept reports from all record collections</label>
            <label class="field">Accepted report collections (comma-separated NSIDs)
                <input name="reportCollections" value="@reportCollections" maxlength="2048" placeholder="app.bsky.feed.post, app.bsky.graph.list" />
            </label>
            <p class="muted">When not accepting all collections, an empty list accepts no record collections.</p>
        </fieldset>
        <fieldset data-policy-declaration-controls>
            <legend>Accepted report reasons</legend>
            <label class="field">Accept
                <select name="reasonMode">
                    <option value="all" selected="@(Model.ReasonTypes is null)">All reasons, including future and custom reasons</option>
                    <option value="selected" selected="@(Model.ReasonTypes is not null)">Only the selected reasons below</option>
                </select>
            </label>
            <p>Reports with other reasons are automatically handled as Not Applicable. They do not enter the open queue or change labels.</p>
            @foreach (var group in ReportReasonOptions.s_all.GroupBy(option => option.Group))
            {
                <details>
                    <summary>@group.Key</summary>
                    @foreach (var option in group)
                    {
                        <label class="field-check"><input type="checkbox" name="reasonTypes" value="@option.Id" checked="@(Model.ReasonTypes?.Contains(option.Id, StringComparer.Ordinal) == true)" /> @option.Title</label>
                    }
                </details>
            }
            <label class="field">Custom reason identifiers (optional, one per line)
                <textarea name="customReasons" maxlength="32768" spellcheck="false">@string.Join("\n", (Model.ReasonTypes ?? []).Where(reason => !ReportReasonOptions.s_all.Any(option => option.Id == reason)))</textarea>
            </label>
            <p>Selecting no reasons accepts none. Original and Ozone reason identifiers are separate; select both versions when you want to support both.</p>
        </fieldset>
        <fieldset>
            <legend>Label issuance permissions</legend>
            <p>These permissions are independent of accepted reports.</p>
            <label class="field-check"><input type="checkbox" name="allowAccounts" value="true" checked="@editor.GetProperty("allowAccounts").GetBoolean()" /> Allow account targets</label>
            <label class="field-check"><input type="checkbox" name="allowRecords" value="true" checked="@editor.GetProperty("allowRecords").GetBoolean()" /> Allow record targets</label>
            <input type="hidden" name="structuredIssuance" value="true" />
            <label class="field-check"><input type="checkbox" name="issueAllCollections" value="true" checked="@issueAllCollections" /> Permit label issuance in all record collections</label>
            <label class="field">Allowed record collections (comma-separated NSIDs)
                <input name="collections" maxlength="2048" value="@(editor.TryGetProperty("allowedRecordCollections", out JsonElement allowed) && allowed.ValueKind == JsonValueKind.Array ? string.Join(", ", allowed.EnumerateArray().Select(value => value.GetString())) : "")" />
            </label>
            <p class="muted">When not permitting all collections, an empty list permits no record collections. Allow record targets must also be enabled.</p>
        </fieldset>
        <label class="field">Operator guidance<textarea name="rules" required maxlength="4096" aria-describedby="policy-guidance-help">@editor.GetProperty("rules").GetString()</textarea></label>
        <p id="policy-guidance-help" class="muted">Instructions for moderators, such as evidence requirements and when to apply a label. Saved with this policy version; not executable and not part of the public declaration.</p>
        </section>
        <section class="panel" id="policy-advanced" data-policy-panel>
            <h2>Advanced declaration JSON</h2>
            <p>Edits to valid JSON update the structured controls. Structured edits update this declaration, preserving unknown extension fields. Issuance permissions and operator guidance are separate and do not appear in the public declaration.</p>
            <label class="field">Declaration JSON<textarea name="declaration" required maxlength="32768" spellcheck="false" aria-describedby="policy-json-error">@Model.DeclarationText</textarea></label>
            <p id="policy-json-error" role="status" aria-live="polite"></p>
            <noscript><p>Without JavaScript, the Moderation Policy report controls replace their corresponding JSON fields when saving. Other declaration fields remain editable here.</p></noscript>
        </section>
        <section class="panel" data-policy-save>
        <h2>Save a policy draft</h2>
        <label class="field">Policy ID<input name="version" required maxlength="256" value="@Model.Version" aria-describedby="policy-id-help" /></label>
        <p id="policy-id-help" class="muted">Choose a unique Policy ID for this saved snapshot. The Policy ID is internal to this app and is not published as part of the policy. Use a new ID when changing policy contents.</p>
        <label class="field">Reason<input name="reason" required maxlength="4096" value="@Model.SaveReason" /></label>
        <p class="form-actions"><button type="submit">Save draft</button></p>
        </section>
    </form>
}
<div id="policy-publication" data-policy-panel>
@if (policy is { ValueKind: JsonValueKind.Object } publication)
{
    <section class="panel">
        <h2>Begin policy publication</h2>
        <p>Publication first withdraws existing applications of label values removed by the new policy, in restart-resumable batches of at most 250 history entries. New issuance is blocked during cleanup. The new declaration cannot be verified or published until all required negations are published. Cleanup runs in the background; you can close this page and return later.</p>
        <p><strong>Negations are permanent moderation changes. If declaration publication fails or is abandoned, completed negations are not automatically undone.</strong></p>
        @if (publication.GetProperty("phase").GetString() == "Withdrawing" &&
            publication.TryGetProperty("withdrawal", out JsonElement withdrawal))
        {
            <h3>Label withdrawal in progress</h3>
            @await Html.PartialAsync("_PolicyWithdrawalStatus", withdrawal)
            <p>Removing: @string.Join(", ", withdrawal.GetProperty("values").EnumerateArray().Select(value => value.GetString()))</p>
            <p>Timestamp scan: @withdrawal.GetProperty("scannedThrough") / @withdrawal.GetProperty("upperBound") history entries.
                Withdrawal scan: @withdrawal.GetProperty("negatedThrough") / @withdrawal.GetProperty("upperBound") history entries.</p>
            <p>Completion also waits for publication of the signed negations. <a asp-page="./Index" asp-fragment="policy-publication">Refresh status</a></p>
            @if (withdrawal.TryGetProperty("pauseReason", out JsonElement pause) && pause.ValueKind == JsonValueKind.String)
            {
                <p class="notice notice-error">@pause.GetString()</p>
            }
            <form method="post" asp-page-handler="Publish">
                <input type="hidden" name="resumeWithdrawal" value="true" />
                <input type="hidden" name="operationId" value="@publication.GetProperty("publicationOperationId").GetString()" />
                <label class="field">Reason<input name="reason" required maxlength="4096" /></label>
                <label><input type="checkbox" name="confirmed" value="true" required /> Authorize continued irreversible withdrawal of these label values under my current administrator authority</label>
                <p class="form-actions"><button type="submit">Resume cleanup</button></p>
            </form>
        }
        else if (publication.GetProperty("phase").GetString() == "Publishing")
        {
            <h3>Ready to publish the declaration</h3>
            <p>Next you must sign into the labeler account. <strong>Your administrator sign-in remains unchanged</strong>.</p>
            <p>Xenon will ask for permission to publish the labeler's declaration, including its label definitions.</p>
            <p>Policy ID: <strong>@publication.GetProperty("definition").GetProperty("version").GetString()</strong></p>
            <p>Xenon checks that the published declaration has not changed unexpectedly before replacing it. If publication of a policy has completed Xenon checks the public policy and will not attempt to replace it. If publication is interrupted, check its status before trying again; anything already published is not automatically undone.</p>
            <form method="post" asp-page-handler="SignInAndPublish">
                <input type="hidden" name="operationId" value="@publication.GetProperty("publicationOperationId").GetString()" />
                <label class="field">Labeler account handle<input name="labelerHandle" required maxlength="253" placeholder="labeler.example" autocomplete="off" /></label>
                <p class="form-actions"><button type="submit">Sign in as the labeler and publish</button></p>
            </form>
        }
        else
        {
        <form method="post" asp-page-handler="Publish">
            <input type="hidden" name="revision" value="@publication.GetProperty("revision").GetInt64()" />
            <input type="hidden" name="operationId" value="@(ViewData["OperationId"] ?? Guid.NewGuid().ToString("N"))" />
            <label class="field">Policy ID
                <select name="version" required aria-describedby="publication-policy-id-help" disabled="@(Model.DraftDefinitions.Count == 0)">
                    <option value="">Select a saved draft</option>
                    @foreach (JsonElement draft in Model.DraftDefinitions)
                    {
                        string draftId = draft.GetProperty("version").GetString()!;
                        <option value="@draftId">@draftId</option>
                    }
                </select>
            </label>
            <p id="publication-policy-id-help" class="muted">Select an unpublished saved draft. The ID is internal to this app and is not published as part of the policy; only the declaration JSON is published.</p>
            @if (Model.DraftDefinitions.Count == 0)
            {
                <p>No saved drafts are available. Save a draft before beginning publication.</p>
            }
            <label class="field">Previous declaration CID (optional)<input name="previousCid" maxlength="128" /></label>
            <label class="field">Reason<input name="reason" required maxlength="4096" /></label>
            <label><input type="checkbox" name="confirmed" value="true" required /> Confirm publication and irreversible batched negation of existing applications of removed label values, even if publication later fails</label>
            <p class="form-actions"><button type="submit" disabled="@(Model.DraftDefinitions.Count == 0)">Begin publication</button></p>
        </form>
        }
    </section>
}
else
{
    <p class="panel">Publication is unavailable until the policy state can be loaded.</p>
}
</div>
<div id="policy-verification" data-policy-panel>
    <section class="panel">
        <h2>Verify declaration</h2>
        <p>Check that the public policy still matches Xenon's saved copy of the last published policy. If a new publication is pending, check against the policy being published instead. This does not change the public policy. A successful match can activate the policy and reopen reporting and label issuance. Verification remains blocked while label withdrawal is in progress.</p>
        <form method="post" asp-page-handler="Verify">
            <p class="form-actions"><button type="submit">Verify declaration</button></p>
        </form>
    </section>
</div>
</div>
