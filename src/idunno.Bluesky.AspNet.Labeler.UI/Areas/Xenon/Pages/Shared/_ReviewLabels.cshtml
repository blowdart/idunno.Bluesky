@model ReviewLabelDisplay
<dl class="review-labels">
    @if (Model.IsRecord)
    {
        <dt>Account labels</dt>
        <dd>
            @if (Model.AccountLabels.Length == 0)
            {
                <span class="muted">None</span>
            }
            else
            {
                <ul class="current-labels">@foreach (string label in Model.AccountLabels)
                    {
                        <li>@label @await Html.PartialAsync("_LabelExpiry", Model.AccountChoices?.FirstOrDefault(choice => choice.Value == label)?.ExpiresAt)</li>
                    }</ul>
            }
        </dd>
    }
    <dt>@(Model.IsRecord ? "Post / record labels" : "Account labels")</dt>
    <dd>
        @if (Model.SubjectLabels.Length == 0)
        {
            <span class="muted">None</span>
        }
        else
        {
            <ul class="current-labels">@foreach (string label in Model.SubjectLabels)
                {
                    <li>@label @await Html.PartialAsync("_LabelExpiry", Model.SubjectChoices?.FirstOrDefault(choice => choice.Value == label)?.ExpiresAt)</li>
                }</ul>
        }
    </dd>
</dl>
<p class="muted label-context-help">Active labels from this labeler. Record labels apply only to the reported CID; account labels are separate.</p>
