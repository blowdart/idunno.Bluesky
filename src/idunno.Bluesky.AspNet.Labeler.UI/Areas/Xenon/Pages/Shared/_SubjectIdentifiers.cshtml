@model System.Text.Json.JsonElement
@if (Model.TryGetProperty("uri", out System.Text.Json.JsonElement uri))
{
    <dl class="subject-identifiers">
        <dt>Content address (AT URI):</dt><dd><code>@uri.GetString()</code></dd>
        @if (Model.TryGetProperty("cid", out System.Text.Json.JsonElement cid))
        {
            <dt>Reported version (CID):</dt><dd><code>@cid.GetString()</code></dd>
        }
        else
        {
            <dt>Reported version:</dt><dd>No specific content version was supplied.</dd>
        }
    </dl>
}
