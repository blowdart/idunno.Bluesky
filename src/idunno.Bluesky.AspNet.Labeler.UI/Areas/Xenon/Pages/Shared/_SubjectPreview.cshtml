@model SubjectPreview
@inject LabelerUiAdministration Administration
@{
    Context.Response.Headers.CacheControl = "private, no-store";
    idunno.Bluesky.Labeler.LabelServiceResult<LabelMediaPreferences> preferences =
        await Administration.MediaPreferencesAsync(User, null, Context.RequestAborted);
    LabelMediaPreferences choices = preferences.Succeeded ? preferences.Result : new();
    LabelMediaFilter filters = LabelMediaFilter.None;
    foreach (string label in Model.MediaLabels ?? [])
    {
        filters |= choices.ForLabel(label);
    }
    if (Model.MediaWarnings is { Length: > 0 } && Model.MediaLabels is not { Length: > 0 })
    {
        filters = LabelMediaFilter.Blur;
    }
    bool blurImages = filters != LabelMediaFilter.None;
    string mediaClasses = "media-warning" + (blurImages ? " media-blurred" : "") +
        (filters.HasFlag(LabelMediaFilter.Blur) ? " media-filter-blur" : "") +
        (filters.HasFlag(LabelMediaFilter.Grayscale) ? " media-filter-grayscale" : "") +
        (filters.HasFlag(LabelMediaFilter.Translucent) ? " media-filter-translucent" : "");
}
<section class="@(Model.Standalone ? "subject-preview standalone-preview" : "subject-preview")" aria-label="@Model.Kind preview">
    <h3>@Model.Kind preview</h3>
    @if (!preferences.Succeeded)
    {
        <p role="alert">Your media preferences could not be loaded. Default blur protection is in use.</p>
    }
    @if (Model.Url is { } url)
    {
        <p><a class="bluesky-link" href="@url" target="_blank" rel="noopener noreferrer" aria-label="Open reported @Model.Kind.ToLowerInvariant() on Bluesky (opens in a new tab)"><span class="fa-icon fa-bluesky" aria-hidden="true"></span>Open @Model.Kind.ToLowerInvariant() on Bluesky</a></p>
    }
    @if (!Model.Standalone && !Model.MatchesReportedVersion)
    {
        <p class="muted">Current public content, not a snapshot of the content when it was reported.</p>
    }
    @if (Model.Error is { } error)
    {
        <p role="status">@error</p>
    }
    else
    {
        @if (Model.ModerationUnavailable)
        {
            <p class="notice notice-status" role="status">Some Bluesky content warnings could not be checked. Media may be shown without a warning.</p>
        }
        <div class="@mediaClasses" data-media-warning="@blurImages.ToString().ToLowerInvariant()">
        <article class="@(Model.Kind == "Profile" ? "profile-preview" : null)" aria-label="Current @Model.Kind.ToLowerInvariant() content">
            @if (Model.Kind == "Profile")
            {
                <div class="profile-preview-banner">
                    @if (Model.Banner?.DataUrl is { } banner)
                    {
                        <img src="@banner" alt="@Model.Banner.Alt" data-sensitive-image="@(blurImages ? "" : null)" aria-hidden="@(blurImages ? "true" : null)" />
                        @if (blurImages)
                        {
                            <partial name="_MediaRevealButton" />
                        }
                    }
                </div>
                <div class="profile-preview-avatar">
                    @if (Model.Avatar?.DataUrl is { } avatar)
                    {
                        <img src="@avatar" alt="@Model.Avatar.Alt" data-sensitive-image="@(blurImages ? "" : null)" aria-hidden="@(blurImages ? "true" : null)" />
                        @if (blurImages)
                        {
                            <partial name="_MediaRevealButton" />
                        }
                    }
                    else
                    {
                        <span class="subject-icon fa-user" aria-hidden="true"></span>
                    }
                </div>
                @if (Model.Banner?.Error is { } bannerError)
                {
                    <p role="status">@bannerError</p>
                }
                @if (Model.Avatar?.Error is { } avatarError)
                {
                    <p role="status">@avatarError</p>
                }
            }
            <p>
                @if (Model.Kind != "Profile")
                {
                    <span class="subject-icon fa-user" aria-hidden="true"></span>
                }
                <strong>@Model.DisplayName</strong> <span>@(Model.Handle?.StartsWith("did:", StringComparison.Ordinal) == true ? Model.Handle : "@" + Model.Handle)</span>
            </p>
            @if (Model.Kind == "Profile" && Model.Followers is { } followers && Model.Following is { } following && Model.Posts is { } posts)
            {
                <p class="profile-preview-counts"><span><strong>@followers.ToString("N0")</strong> followers</span> <span><strong>@following.ToString("N0")</strong> following</span> <span><strong>@posts.ToString("N0")</strong> posts</span></p>
            }
            <p class="preview-text" dir="auto">@Model.Text</p>
            @if (Model.CreatedAt is { } createdAt)
            {
                <p><time datetime="@createdAt.ToString("O")">@createdAt.ToUniversalTime().ToString("u")</time></p>
            }
            @if (Model.DifferentVersion)
            {
                <p class="notice notice-error" role="note">The current @Model.Kind.ToLowerInvariant() CID differs from the reported CID. This preview is not the reported version.</p>
            }
            @if (!Model.Standalone && !Model.MatchesReportedVersion && Model.Cid is { } cid)
            {
                <p>Current CID: <code>@cid</code></p>
            }
            @if (Model.Images is { Length: > 0 } images)
            {
                <div class="@(Model.Gallery ? "preview-images preview-gallery" : "preview-images")" tabindex="@(Model.Gallery ? "0" : null)" role="@(Model.Gallery ? "region" : null)" aria-label="@(Model.Gallery ? "Post image gallery; scroll horizontally to see all images" : null)">
                    @foreach (PreviewImage image in images)
                    {
                        <figure>
                            @if (image.DataUrl is { } dataUrl)
                            {
                                <div class="preview-image">
                                    <img src="@dataUrl" alt="@(string.IsNullOrWhiteSpace(image.Alt) ? "Reported image (no description supplied)" : image.Alt)" data-sensitive-image="@(blurImages ? "" : null)" aria-hidden="@(blurImages ? "true" : null)" />
                                    @if (blurImages)
                                    {
                                        <partial name="_MediaRevealButton" />
                                    }
                                </div>
                            }
                            else
                            {
                                <p>@image.Error</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(image.Alt))
                            {
                                <figcaption>@image.Alt</figcaption>
                            }
                        </figure>
                    }
                </div>
            }
            @if (Model.MediaNotice is { } notice)
            {
                <p class="muted">@notice</p>
            }
            @if (Model.VideoToken is { } videoToken)
            {
                <div class="video-preview">
                    @if (blurImages)
                    {
                        <partial name="_MediaRevealButton" />
                    }
                    <video controls="@(!blurImages)" preload="none" playsinline
                           src="@Url.Page("/Media", new { area = "Xenon", token = videoToken })"
                           width="@Model.VideoWidth" height="@Model.VideoHeight"
                           data-sensitive-image="@(blurImages ? "" : null)" aria-hidden="@(blurImages ? "true" : null)"
                           aria-label="@(Model.VideoAlt ?? "Post video")"></video>
                    <p role="status" data-video-error hidden>The video could not be loaded. Reload the details to try again.</p>
                    @if (!string.IsNullOrWhiteSpace(Model.VideoAlt))
                    {
                        <p>@Model.VideoAlt</p>
                    }
                </div>
            }
        </article>
        @if (Model.MediaWarnings is { Length: > 0 })
        {
            <div class="media-warning-caption">
                <p role="note"><span class="fa-icon fa-circle-exclamation" aria-hidden="true"></span> Sensitive media: @string.Join(", ", Model.MediaWarnings!).</p>
                @if (blurImages)
                {
                    <noscript><p>Showing filtered media requires JavaScript.</p></noscript>
                }
            </div>
        }
        </div>
    }
</section>
