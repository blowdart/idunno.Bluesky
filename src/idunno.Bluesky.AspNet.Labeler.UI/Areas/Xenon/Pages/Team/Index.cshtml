@page
@model idunno.Bluesky.AspNet.Labeler.UI.Areas.Xenon.Pages.Team.IndexModel
@using System.Text.Json
@using idunno.Bluesky.Labeler.Administration
@{
    ViewData["Title"] = "Team";
    ViewData["WideLayout"] = true;
    JsonElement? members = Model.Data.ValueKind == JsonValueKind.Object &&
        Model.Data.TryGetProperty("members", out JsonElement values) ? values : null;
    string remoteAccessIcon = Model.RemoteAdministrationEnabled switch
    {
        true => "circle-check",
        false => "circle-xmark",
        null => "circle-exclamation"
    };
}
<h1>Team and membership</h1>
<p>Permissions belong to the member's account, even if their handle changes. Suspension, removal and role changes apply the next time the service checks their permissions; they do not undo completed actions.</p>
<section class="panel">
    <h2>Remote CLI administration</h2>
    <p>Choose whether team members can use the administration command-line tool over HTTPS. Their usual account permissions still apply. This setting does not disable Xenon or local administration on the server.</p>
    @if (ViewData["RemoteAdministrationError"] is string remoteAdministrationError)
    {
        <p role="alert">@remoteAdministrationError</p>
    }
    @if (Model.RemoteAdministrationControlMode == RemoteAdministrationMode.WebUiControlled)
    {
        <p><span class="fa-icon fa-@remoteAccessIcon" aria-hidden="true"></span> Remote CLI access is <strong>@(Model.RemoteAdministrationEnabled switch { true => "enabled", false => "disabled", null => "unavailable" })</strong>.</p>
        @if (Model.CanControlRemoteAdministration && Model.RemoteAdministrationEnabled is bool currentRemoteEnabled)
        {
            <form method="post" asp-page-handler="RemoteAdministration">
                <input type="hidden" name="operationId" value="@(ViewData["OperationId"] ?? Guid.NewGuid().ToString("N"))" />
                <input type="hidden" name="enabled" value="@((!currentRemoteEnabled).ToString().ToLowerInvariant())" />
                <label class="field" for="remote-administration-reason">Audit reason
                    <input id="remote-administration-reason" name="reason" required maxlength="4096" />
                </label>
                <p class="form-actions"><button type="submit">@(currentRemoteEnabled ? "Disable remote CLI access" : "Enable remote CLI access")</button></p>
            </form>
        }
        else
        {
            <p>Only the account that originally set up this labeler can change this setting.</p>
        }
    }
    else
    {
        <p><span class="fa-icon fa-@remoteAccessIcon" aria-hidden="true"></span> Remote CLI access is <strong>@(Model.RemoteAdministrationEnabled switch { true => "enabled", false => "disabled", null => "unavailable" })</strong> in the server settings.</p>
    }
</section>
@if (Model.CanManagePolicyEmail)
{
    <section class="panel">
        <h2>Administrator email notifications</h2>
        <p>@(Model.CurrentNotificationEmail is null
            ? "Add an email address for administrator notifications."
            : "Update your email address for administrator notifications.")
            Notifications go only to active administrators with a registered address. Leave the field blank to clear your address.</p>
        <p>When email is enabled on the server, notifications cover published policies, team membership and role changes, remote or local CLI access changes, and automatic public policy check failures. Active administrators with a registered notification email receive these notifications even when only one administrator is active. No emails are sent to moderators.</p>
        <form method="post" asp-page-handler="NotificationEmail">
            <input type="hidden" name="operationId" value="@(ViewData["OperationId"] ?? Guid.NewGuid().ToString("N"))" />
            <label class="field" for="notification-email">Your alert email address
                <input id="notification-email" name="notificationEmail" type="email" value="@Model.CurrentNotificationEmail" maxlength="254" autocomplete="email" />
            </label>
            <p class="form-actions"><button type="submit">@(Model.CurrentNotificationEmail is null ? "Save alert email" : "Update email")</button></p>
        </form>
        <form method="post" asp-page-handler="TestEmail">
            <button type="submit">Test my email</button>
        </form>
        <p class="muted">Tests use your saved address, not unsaved changes above. Allow 30 seconds between tests.</p>
    </section>
}
<form method="get" class="panel team-search">
    <label class="field" for="team-search">Member handle or account ID (DID)
        <input id="team-search" name="Search" value="@Request.Query["Search"]" maxlength="256" placeholder="DID or handle" />
    </label>
    <div class="team-search-actions"><button type="submit">Search</button><a asp-page="./Index">Clear</a></div>
</form>
@if (members is { ValueKind: JsonValueKind.Array } list)
{
    <section class="panel">
        <table class="team-members">
            <caption>@Model.Table!.Total @(Model.Table.Total == 1 ? "member" : "members"), including removed members</caption>
            <thead><tr>
                @await Html.PartialAsync("_SortHeader", new TableSortHeader(Model.Table!, LabelTableSort.Subject, "Member"))
                @await Html.PartialAsync("_SortHeader", new TableSortHeader(Model.Table!, LabelTableSort.Role, "Role"))
                @await Html.PartialAsync("_SortHeader", new TableSortHeader(Model.Table!, LabelTableSort.Status, "Status"))
            </tr></thead>
            <tbody>
                @foreach (JsonElement member in list.EnumerateArray())
                {
                    LabelTeamRole role = (LabelTeamRole)member.GetProperty("role").GetInt32();
                    bool removed = member.GetProperty("removed").GetBoolean();
                    (string status, string statusIcon) = (removed, member.GetProperty("active").GetBoolean()) switch
                    {
                        (true, _) => ("Removed", "circle-xmark"),
                        (false, true) => ("Active", "circle-check"),
                        (false, false) => ("Suspended", "circle-pause")
                    };
                    string? roleIcon = role switch
                    {
                        LabelTeamRole.Viewer => "eye",
                        LabelTeamRole.Moderator => "gavel",
                        LabelTeamRole.Administrator => "user-gear",
                        _ => null
                    };
                    <tr class="@(removed ? "team-member-removed" : null)">
                        <td><a asp-page="./Index"
                               asp-route-member="@member.GetProperty("did").GetString()"
                               asp-route-Sort="@Model.Table!.Query.Sort"
                               asp-route-Ascending="@Model.Table.Query.Ascending"
                               asp-route-PageNumber="@Model.Table.Page"
                               asp-route-Search="@Request.Query["Search"]"
                               asp-fragment="change-member">@await Html.PartialAsync("_Identity", new IdentityDisplayModel(member.GetProperty("did").GetString()))</a></td>
                        <td>@if (roleIcon is not null)
                            {
                                <span class="fa-icon fa-@roleIcon" aria-hidden="true"></span>
                            }
                            @role</td>
                        <td><span class="fa-icon fa-@statusIcon" aria-hidden="true"></span> @status</td>
                    </tr>
                }
            </tbody>
        </table>
        @await Html.PartialAsync("_Pagination", Model.Table)
    </section>
}
<div class="grid">
    <section class="panel">
        <h2>Add a team member</h2>
        <form method="post" asp-page-handler="Enroll">
            <input type="hidden" name="operationId" value="@(ViewData["OperationId"] ?? Guid.NewGuid().ToString("N"))" />
            <label class="field">Handle or account ID (DID)<input name="target" required maxlength="256" /></label>
            <label class="field">Role
                <select name="role"><option value="Viewer">Viewer</option><option value="Moderator">Moderator</option><option value="Administrator">Administrator</option></select>
            </label>
            <label class="field">Reason<input name="reason" required maxlength="4096" /></label>
            <p class="form-actions"><button type="submit">Add member</button></p>
        </form>
    </section>
    <section class="panel" id="change-member">
        <h2>Change member</h2>
        <form method="post" asp-page-handler="Change" data-team-change>
            <input type="hidden" name="operationId" value="@(ViewData["OperationId"] ?? Guid.NewGuid().ToString("N"))" />
            <label class="field">Member account ID (DID)<input name="target" value="@Model.SelectedMember" required maxlength="256" /></label>
            <label class="field">Action
                <select name="action"><option value="SetRole">Change role</option><option value="Suspend">Suspend</option><option value="Reinstate">Reinstate</option><option value="Remove">Remove</option></select>
            </label>
            <label class="field" data-team-role>Role (used for Change role)
                <select name="role">
                    @foreach (LabelTeamRole role in Enum.GetValues<LabelTeamRole>())
                    {
                        <option value="@role" selected="@(role == Model.SelectedRole)">@role</option>
                    }
                </select>
            </label>
            <label class="field">Reason<input name="reason" required maxlength="4096" /></label>
            <p class="form-actions"><button type="submit">Update</button></p>
        </form>
    </section>
</div>
