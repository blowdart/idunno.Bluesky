<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <Description>Optional Xenon Razor Pages administration UI for standalone AT Protocol labelers.</Description>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>atproto;bluesky;aspnetcore;labeler;moderation;razorpages;admin</PackageTags>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetBasePath>Xenon</StaticWebAssetBasePath>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup Condition="'$(BuildCommitId)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildCommitId</_Parameter1>
      <_Parameter2>$(BuildCommitId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="idunno.Bluesky.Labeler.Cli.Test, " />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\idunno.Bluesky.AspNet.Authentication\idunno.Bluesky.AspNet.Authentication.csproj" />
    <ProjectReference Include="..\idunno.Bluesky.AspNet.Labeler\idunno.Bluesky.AspNet.Labeler.csproj" />
    <None Include="readme.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\exclusion.dic" Link="exclusion.dic" />
  </ItemGroup>
</Project>
