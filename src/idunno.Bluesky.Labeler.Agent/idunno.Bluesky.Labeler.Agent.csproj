    <Description>Remote labeler client for AT Protocol bots.</Description>
    <PackageTags>atproto;bluesky;labeler;bot</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\exclusion.dic" Link="exclusion.dic" />
    <ProjectReference Include="..\idunno.AtProto\idunno.AtProto.csproj" />
    <ProjectReference Include="..\idunno.Bluesky.Labeler\idunno.Bluesky.Labeler.csproj" />
  </ItemGroup>
</Project>
