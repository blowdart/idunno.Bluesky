<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Description>The canonical labeler application with external PostgreSQL label and authentication persistence.</Description>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPublishable>true</IsPublishable>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\idunno.Bluesky.Labeler.Host\idunno.Bluesky.Labeler.Host.csproj" />
    <ProjectReference Include="..\idunno.Bluesky.Labeler.PostgreSQL\idunno.Bluesky.Labeler.PostgreSQL.csproj" />
    <ProjectReference Include="..\idunno.Bluesky.AspNet.Authentication.PostgreSQL\idunno.Bluesky.AspNet.Authentication.PostgreSQL.csproj" />
    <EmbeddedResource Include="..\idunno.Bluesky.AspNet.Authentication.PostgreSQL\schema.sql" LogicalName="Labeler.AuthenticationSchema.sql" />
    <Content Include="..\idunno.Bluesky.Labeler.Host\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="idunno.Bluesky.Labeler.Cli.Test, " />
  </ItemGroup>
</Project>
