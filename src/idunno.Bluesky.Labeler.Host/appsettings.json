{
  "Labeler": {
    "SigningKeyProvider": "environment",
    "AllowAccountLabels": false,
    "AllowRecordLabels": false,
    "TrustedProxies": [],
    "ForwardLimit": 1
  },
  "LabelerAdministration": {
    "RemoteEnabled": false
  },
  "LabelerTelemetry": {
    "Prometheus": {
      "Enabled": false,
      "Address": "127.0.0.1",
      "Port": 9464
    },
    "Otlp": {
      "Enabled": false
    }
  },
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z' ",
        "UseUtcTimestamp": true
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
