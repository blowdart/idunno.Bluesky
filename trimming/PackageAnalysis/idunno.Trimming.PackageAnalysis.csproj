<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <Configurations>Debug;Release;CodeQL</Configurations>
    <UsePackedPackages Condition="'$(UsePackedPackages)' == ''">false</UsePackedPackages>
  </PropertyGroup>

  <ItemGroup Condition="'$(UsePackedPackages)' != 'true'">
    <ProjectReference Include="..\..\src\idunno.AtProto.Types\idunno.AtProto.Types.csproj" />
    <ProjectReference Include="..\..\src\idunno.AtProto\idunno.AtProto.csproj" />
    <ProjectReference Include="..\..\src\idunno.AtProto.OAuthCallback\idunno.AtProto.OAuthCallback.csproj" />
    <ProjectReference Include="..\..\src\idunno.Bluesky\idunno.Bluesky.csproj" />
    <ProjectReference Include="..\..\src\idunno.Bluesky.AspNet.Authentication\idunno.Bluesky.AspNet.Authentication.csproj" />
    <ProjectReference Include="..\..\src\idunno.Bluesky.AspNet.Authentication.MySQL\idunno.Bluesky.AspNet.Authentication.MySQL.csproj" />
    <ProjectReference Include="..\..\src\idunno.Bluesky.AspNet.Authentication.PostgreSQL\idunno.Bluesky.AspNet.Authentication.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\src\idunno.Bluesky.AspNet.Authentication.Redis\idunno.Bluesky.AspNet.Authentication.Redis.csproj" />
    <ProjectReference Include="..\..\src\idunno.Bluesky.AspNet.Authentication.SQLite\idunno.Bluesky.AspNet.Authentication.SQLite.csproj" />
    <ProjectReference Include="..\..\src\idunno.Bluesky.AspNet.Labeler\idunno.Bluesky.AspNet.Labeler.csproj" />
    <ProjectReference Include="..\..\src\idunno.Bluesky.BotSdk\idunno.Bluesky.BotSdk.csproj" />
    <ProjectReference Include="..\..\src\idunno.Bluesky.BotSdk.MySQL\idunno.Bluesky.BotSdk.MySQL.csproj" />
    <ProjectReference Include="..\..\src\idunno.Bluesky.BotSdk.PostgreSQL\idunno.Bluesky.BotSdk.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\src\idunno.Bluesky.BotSdk.SQLite\idunno.Bluesky.BotSdk.SQLite.csproj" />
    <ProjectReference Include="..\..\src\idunno.Bluesky.Labeler\idunno.Bluesky.Labeler.csproj" />
    <ProjectReference Include="..\..\src\idunno.Bluesky.Labeler.MySQL\idunno.Bluesky.Labeler.MySQL.csproj" />
    <ProjectReference Include="..\..\src\idunno.Bluesky.Labeler.PostgreSQL\idunno.Bluesky.Labeler.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\src\idunno.Bluesky.Labeler.SQLite\idunno.Bluesky.Labeler.SQLite.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePackedPackages)' == 'true'">
    <PackageReference Include="idunno.AtProto.Types" VersionOverride="$(IdunnoPackageVersion)" />
    <PackageReference Include="idunno.AtProto" VersionOverride="$(IdunnoPackageVersion)" />
    <PackageReference Include="idunno.AtProto.OAuthCallback" VersionOverride="$(IdunnoPackageVersion)" />
    <PackageReference Include="idunno.Bluesky" VersionOverride="$(IdunnoPackageVersion)" />
    <PackageReference Include="idunno.Bluesky.AspNet.Authentication" VersionOverride="$(IdunnoPackageVersion)" />
    <PackageReference Include="idunno.Bluesky.AspNet.Authentication.MySQL" VersionOverride="$(IdunnoPackageVersion)" />
    <PackageReference Include="idunno.Bluesky.AspNet.Authentication.PostgreSQL" VersionOverride="$(IdunnoPackageVersion)" />
    <PackageReference Include="idunno.Bluesky.AspNet.Authentication.Redis" VersionOverride="$(IdunnoPackageVersion)" />
    <PackageReference Include="idunno.Bluesky.AspNet.Authentication.SQLite" VersionOverride="$(IdunnoPackageVersion)" />
    <PackageReference Include="idunno.Bluesky.AspNet.Labeler" VersionOverride="$(IdunnoPackageVersion)" />
    <PackageReference Include="idunno.Bluesky.BotSdk" VersionOverride="$(IdunnoPackageVersion)" />
    <PackageReference Include="idunno.Bluesky.BotSdk.MySQL" VersionOverride="$(IdunnoPackageVersion)" />
    <PackageReference Include="idunno.Bluesky.BotSdk.PostgreSQL" VersionOverride="$(IdunnoPackageVersion)" />
    <PackageReference Include="idunno.Bluesky.BotSdk.SQLite" VersionOverride="$(IdunnoPackageVersion)" />
    <PackageReference Include="idunno.Bluesky.Labeler" VersionOverride="$(IdunnoPackageVersion)" />
    <PackageReference Include="idunno.Bluesky.Labeler.MySQL" VersionOverride="$(IdunnoPackageVersion)" />
    <PackageReference Include="idunno.Bluesky.Labeler.PostgreSQL" VersionOverride="$(IdunnoPackageVersion)" />
    <PackageReference Include="idunno.Bluesky.Labeler.SQLite" VersionOverride="$(IdunnoPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="idunno.AtProto.Types" />
    <TrimmerRootAssembly Include="idunno.AtProto" />
    <TrimmerRootAssembly Include="idunno.AtProto.OAuthCallback" />
    <TrimmerRootAssembly Include="idunno.Bluesky" />
    <TrimmerRootAssembly Include="idunno.Bluesky.AspNet.Authentication" />
    <TrimmerRootAssembly Include="idunno.Bluesky.AspNet.Authentication.MySQL" />
    <TrimmerRootAssembly Include="idunno.Bluesky.AspNet.Authentication.PostgreSQL" />
    <TrimmerRootAssembly Include="idunno.Bluesky.AspNet.Authentication.Redis" />
    <TrimmerRootAssembly Include="idunno.Bluesky.AspNet.Authentication.SQLite" />
    <TrimmerRootAssembly Include="idunno.Bluesky.AspNet.Labeler" />
    <TrimmerRootAssembly Include="idunno.Bluesky.BotSdk" />
    <TrimmerRootAssembly Include="idunno.Bluesky.BotSdk.MySQL" />
    <TrimmerRootAssembly Include="idunno.Bluesky.BotSdk.PostgreSQL" />
    <TrimmerRootAssembly Include="idunno.Bluesky.BotSdk.SQLite" />
    <TrimmerRootAssembly Include="idunno.Bluesky.Labeler" />
    <TrimmerRootAssembly Include="idunno.Bluesky.Labeler.MySQL" />
    <TrimmerRootAssembly Include="idunno.Bluesky.Labeler.PostgreSQL" />
    <TrimmerRootAssembly Include="idunno.Bluesky.Labeler.SQLite" />
  </ItemGroup>

</Project>
